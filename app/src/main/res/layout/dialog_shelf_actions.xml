<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvActionDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvActionDialogSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnActionExtra"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnActionDeleteOne"
        android:nextFocusLeft="@+id/btnActionExtra"
        android:nextFocusRight="@+id/btnActionExtra"
        android:nextFocusUp="@+id/btnActionExtra"
        android:textColor="@color/text_button_accent_selector"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnActionDeleteOne"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnActionClearAll"
        android:nextFocusLeft="@+id/btnActionDeleteOne"
        android:nextFocusRight="@+id/btnActionDeleteOne"
        android:nextFocusUp="@+id/btnActionDeleteOne"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnActionClearAll"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnActionCancel"
        android:nextFocusLeft="@+id/btnActionClearAll"
        android:nextFocusRight="@+id/btnActionClearAll"
        android:nextFocusUp="@+id/btnActionDeleteOne"
        android:textColor="@color/status_err"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnActionCancel"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnActionCancel"
        android:nextFocusLeft="@+id/btnActionCancel"
        android:nextFocusRight="@+id/btnActionCancel"
        android:nextFocusUp="@+id/btnActionClearAll"
        android:text="@string/btn_cancel"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
