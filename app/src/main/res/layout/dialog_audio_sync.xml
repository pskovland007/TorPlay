<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audio_sync_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/audio_sync_hint"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvAudioSyncValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:text="0.0 с (0 мс)"
        android:textColor="@color/accent_emerald"
        android:textSize="22sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSyncMinus500"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSyncDone"
            android:nextFocusLeft="@+id/btnSyncMinus500"
            android:nextFocusRight="@+id/btnSyncMinus100"
            android:nextFocusUp="@+id/btnSyncMinus500"
            android:text="-0.5с"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSyncMinus100"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSyncDone"
            android:nextFocusLeft="@+id/btnSyncMinus500"
            android:nextFocusRight="@+id/btnSyncReset"
            android:nextFocusUp="@+id/btnSyncMinus100"
            android:text="-0.1с"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSyncReset"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSyncDone"
            android:nextFocusLeft="@+id/btnSyncMinus100"
            android:nextFocusRight="@+id/btnSyncPlus100"
            android:nextFocusUp="@+id/btnSyncReset"
            android:text="@string/audio_sync_reset"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSyncPlus100"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSyncDone"
            android:nextFocusLeft="@+id/btnSyncReset"
            android:nextFocusRight="@+id/btnSyncPlus500"
            android:nextFocusUp="@+id/btnSyncPlus100"
            android:text="+0.1с"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSyncPlus500"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSyncDone"
            android:nextFocusLeft="@+id/btnSyncPlus100"
            android:nextFocusRight="@+id/btnSyncPlus500"
            android:nextFocusUp="@+id/btnSyncPlus500"
            android:text="+0.5с"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSyncDone"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnSyncDone"
        android:nextFocusLeft="@+id/btnSyncDone"
        android:nextFocusRight="@+id/btnSyncDone"
        android:nextFocusUp="@+id/btnSyncPlus100"
        android:text="@string/audio_sync_done"
        android:textColor="@color/text_button_accent_selector"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
