<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="12dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/text_primary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>


        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_player_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnPlayerBuiltin"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnBufferFast"
                android:nextFocusLeft="@+id/btnPlayerBuiltin"
                android:nextFocusRight="@+id/btnPlayerExternal"
                android:nextFocusUp="@+id/btnPlayerBuiltin"
                android:text="Встроенный (Media3)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlayerExternal"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnBuffer4k"
                android:nextFocusLeft="@+id/btnPlayerBuiltin"
                android:nextFocusRight="@+id/btnPlayerExternal"
                android:nextFocusUp="@+id/btnPlayerExternal"
                android:text="Внешний (MX Player)"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_buffer_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBufferFast"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnTogglePublicJacRed"
                android:nextFocusLeft="@+id/btnBufferFast"
                android:nextFocusRight="@+id/btnBufferStandard"
                android:nextFocusUp="@+id/btnPlayerBuiltin"
                android:text="@string/buffer_fast"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBufferStandard"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnTogglePublicJacRed"
                android:nextFocusLeft="@+id/btnBufferFast"
                android:nextFocusRight="@+id/btnBuffer4k"
                android:nextFocusUp="@+id/btnPlayerBuiltin"
                android:text="@string/buffer_standard"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBuffer4k"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnToggleRutorFallback"
                android:nextFocusLeft="@+id/btnBufferStandard"
                android:nextFocusRight="@+id/btnBuffer4k"
                android:nextFocusUp="@+id/btnPlayerExternal"
                android:text="@string/buffer_4k"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_sources_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTogglePublicJacRed"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnToggleAutoUpdate"
                android:nextFocusLeft="@+id/btnTogglePublicJacRed"
                android:nextFocusRight="@+id/btnToggleRutorFallback"
                android:nextFocusUp="@+id/btnBufferFast"
                android:text="@string/source_jacred_on"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnToggleRutorFallback"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCheckUpdates"
                android:nextFocusLeft="@+id/btnTogglePublicJacRed"
                android:nextFocusRight="@+id/btnToggleRutorFallback"
                android:nextFocusUp="@+id/btnBuffer4k"
                android:text="@string/source_rutor_on"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_updates_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnToggleAutoUpdate"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1.1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/etTorrServeUrl"
                android:nextFocusLeft="@+id/btnToggleAutoUpdate"
                android:nextFocusRight="@+id/btnCheckUpdates"
                android:nextFocusUp="@+id/btnTogglePublicJacRed"
                android:text="@string/auto_update_on"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCheckUpdates"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.9"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/etTorrServeUrl"
                android:nextFocusLeft="@+id/btnToggleAutoUpdate"
                android:nextFocusRight="@+id/btnCheckUpdates"
                android:nextFocusUp="@+id/btnToggleRutorFallback"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/btn_check_update_now"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_torrserve_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTorrServeUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="http://127.0.0.1:8090"
            android:inputType="textUri"
            android:nextFocusDown="@+id/etCustomParserUrl"
            android:nextFocusUp="@+id/btnToggleAutoUpdate"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_jacred_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etCustomParserUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="Оставьте пустым для автоподбора"
            android:inputType="textUri"
            android:nextFocusDown="@+id/etApiKey"
            android:nextFocusUp="@+id/etTorrServeUrl"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_apikey_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="API Key (если требуется)"
            android:inputType="text"
            android:nextFocusDown="@+id/etRutorMirror"
            android:nextFocusUp="@+id/etCustomParserUrl"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_rutor_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etRutorMirror"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input_selector"
            android:hint="https://rutor.info"
            android:inputType="textUri"
            android:nextFocusDown="@+id/btnToggleTmdbShowcase"
            android:nextFocusUp="@+id/etApiKey"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Catalog Settings (Kinopoisk / TMDB) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_tmdb_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/btnToggleTmdbShowcase"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnCatalogTorrents"
            android:nextFocusLeft="@+id/btnToggleTmdbShowcase"
            android:nextFocusRight="@+id/btnToggleTmdbShowcase"
            android:nextFocusUp="@+id/etRutorMirror"
            android:text="@string/tmdb_showcase_on"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCatalogTorrents"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.25"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/etKinopoiskApiKey"
                android:nextFocusLeft="@+id/btnCatalogTorrents"
                android:nextFocusRight="@+id/btnCatalogKinopoisk"
                android:nextFocusUp="@+id/btnToggleTmdbShowcase"
                android:text="@string/catalog_provider_torrents"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCatalogKinopoisk"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/etKinopoiskApiKey"
                android:nextFocusLeft="@+id/btnCatalogTorrents"
                android:nextFocusRight="@+id/btnCatalogTmdb"
                android:nextFocusUp="@+id/btnToggleTmdbShowcase"
                android:text="@string/catalog_provider_kinopoisk"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnCatalogTmdb"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.8"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/etKinopoiskApiKey"
                android:nextFocusLeft="@+id/btnCatalogKinopoisk"
                android:nextFocusRight="@+id/btnCatalogTmdb"
                android:nextFocusUp="@+id/btnToggleTmdbShowcase"
                android:text="@string/catalog_provider_tmdb"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_kp_key_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etKinopoiskApiKey"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="Ключ X-API-KEY с kinopoiskapiunofficial.tech"
            android:inputType="text"
            android:nextFocusDown="@+id/etTmdbApiKey"
            android:nextFocusUp="@+id/btnCatalogTorrents"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_tmdb_key_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTmdbApiKey"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="Бесплатный ключ с themoviedb.org"
            android:inputType="text"
            android:nextFocusDown="@+id/etTmdbApiUrl"
            android:nextFocusUp="@+id/etKinopoiskApiKey"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_tmdb_api_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTmdbApiUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_selector"
            android:hint="https://api.themoviedb.org/3"
            android:inputType="textUri"
            android:nextFocusDown="@+id/etTmdbImageUrl"
            android:nextFocusUp="@+id/etTmdbApiKey"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_tmdb_img_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTmdbImageUrl"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_input_selector"
            android:hint="https://image.tmdb.org/t/p/w342"
            android:inputType="textUri"
            android:nextFocusDown="@+id/btnTorrServeManager"
            android:nextFocusUp="@+id/etTmdbApiUrl"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="14sp" />

        <!-- Maintenance & Backup Row -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_maintenance_label"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTorrServeManager"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1.15"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCheckMirrors"
                android:nextFocusLeft="@+id/btnTorrServeManager"
                android:nextFocusRight="@+id/btnBackupExport"
                android:nextFocusUp="@+id/etTmdbImageUrl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_torrserve_manager"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBackupExport"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCancelSettings"
                android:nextFocusLeft="@+id/btnTorrServeManager"
                android:nextFocusRight="@+id/btnBackupImport"
                android:nextFocusUp="@+id/etTmdbImageUrl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_backup_export"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnBackupImport"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCancelSettings"
                android:nextFocusLeft="@+id/btnBackupExport"
                android:nextFocusRight="@+id/btnExportLogs"
                android:nextFocusUp="@+id/etTmdbImageUrl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_backup_import"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnExportLogs"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="0.95"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnSaveSettings"
                android:nextFocusLeft="@+id/btnBackupImport"
                android:nextFocusRight="@+id/btnExportLogs"
                android:nextFocusUp="@+id/etTmdbImageUrl"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/btn_export_logs"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Mirror Check Results Panel -->
        <LinearLayout
            android:id="@+id/layoutMirrorResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_input_selector"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ProgressBar
                    android:id="@+id/progressMirrorCheck"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/accent_emerald"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvMirrorCheckStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/checking_mirrors"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutMirrorList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Action Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnCheckMirrors"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCheckMirrors"
                android:nextFocusLeft="@+id/btnCheckMirrors"
                android:nextFocusRight="@+id/btnCancelSettings"
                android:nextFocusUp="@+id/btnTorrServeManager"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_check_mirrors"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="13sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/btnCancelSettings"
                android:layout_width="106dp"
                android:layout_height="40dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnCancelSettings"
                android:nextFocusLeft="@+id/btnCheckMirrors"
                android:nextFocusRight="@+id/btnSaveSettings"
                android:nextFocusUp="@+id/btnBackupImport"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSaveSettings"
                android:layout_width="124dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnSaveSettings"
                android:nextFocusLeft="@+id/btnCancelSettings"
                android:nextFocusRight="@+id/btnSaveSettings"
                android:nextFocusUp="@+id/btnExportLogs"
                android:text="@string/btn_save"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
