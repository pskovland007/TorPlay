<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlcVideoLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Touch gesture surface when OSD is hidden -->
    <View
        android:id="@+id/viewTouchSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false" />

    <!-- Variant A: Persistent Glassmorphic Corner Speed & Peers Pill (with Plasma/OLED pixel shift) -->
    <LinearLayout
        android:id="@+id/layoutCornerStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginStart="22dp"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="22dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_player_corner_stats"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:visibility="gone">

        <View
            android:id="@+id/viewCornerStatsDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_corner_dot" />

        <TextView
            android:id="@+id/tvCornerSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="0 КБ/с"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_marginEnd="7dp"
            android:text="•"
            android:textColor="#80FFFFFF"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvCornerPeers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:text="▲ 0/0"
            android:textColor="@color/accent_emerald"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Live TorrServe Buffering Overlay inside Player -->
    <LinearLayout
        android:id="@+id/layoutPlayerBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_dialog"
        android:gravity="center"
        android:minWidth="280dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/progressPlayerBuffering"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:indeterminateTint="@color/accent_emerald" />

        <TextView
            android:id="@+id/tvBufferingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/player_buffering_title"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvBufferingStats"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnStartFromBeginning"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_player_pill_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/player_start_from_zero"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quick HUD toast pill (seek / volume / brightness / boost feedback) -->
    <TextView
        android:id="@+id/tvQuickHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="28dp"
        android:background="@drawable/bg_dialog"
        android:paddingStart="18dp"
        android:paddingTop="9dp"
        android:paddingEnd="18dp"
        android:paddingBottom="9dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Full OSD Overlay (Variant 1: Center Translucent Circles + Single-Row Bottom Dock) -->
    <FrameLayout
        android:id="@+id/layoutOsd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <!-- Tap outside buttons to dismiss OSD -->
        <View
            android:id="@+id/viewOsdDismissArea"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="false" />

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:background="@drawable/bg_player_top_gradient"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="18dp"
            android:paddingEnd="28dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/tvPlayerTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStreamInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Center Variant 1 Translucent Touch/D-pad Circles -->
        <LinearLayout
            android:id="@+id/layoutCenterControls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRewind"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginEnd="26dp"
                android:background="@drawable/bg_player_circle_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:nextFocusDown="@+id/btnAudioTrack"
                android:nextFocusLeft="@+id/btnRewind"
                android:nextFocusRight="@+id/btnPlayPause"
                android:nextFocusUp="@+id/btnRewind"
                android:text="«\n-10с"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlayPause"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:background="@drawable/bg_player_circle_center_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnAudioBoost"
                android:nextFocusLeft="@+id/btnRewind"
                android:nextFocusRight="@+id/btnForward"
                android:nextFocusUp="@+id/btnPlayPause"
                android:text="❚❚"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnForward"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginStart="26dp"
                android:background="@drawable/bg_player_circle_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingMultiplier="0.95"
                android:nextFocusDown="@+id/btnSubtitles"
                android:nextFocusLeft="@+id/btnPlayPause"
                android:nextFocusRight="@+id/btnForward"
                android:nextFocusUp="@+id/btnForward"
                android:text="»\n+10с"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Bottom Bar: Progress + ONE Single Row of Pill Buttons (No Rewind/Forward) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_player_bottom_gradient"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="22dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Seekbar row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="56dp"
                    android:text="00:00"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:focusable="false"
                    android:max="1000"
                    android:progressTint="@color/accent_emerald"
                    android:thumbTint="@color/accent_emerald" />

                <TextView
                    android:id="@+id/tvTotalTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:minWidth="56dp"
                    android:text="--:--"
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Single-row controls dock -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutBottomButtons"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp">

                    <TextView
                        android:id="@+id/btnAudioTrack"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnAudioTrack"
                        android:nextFocusLeft="@+id/btnAudioTrack"
                        android:nextFocusRight="@+id/btnAudioBoost"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_audio_short"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAudioBoost"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnAudioBoost"
                        android:nextFocusLeft="@+id/btnAudioTrack"
                        android:nextFocusRight="@+id/btnSubtitles"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_boost_off"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnSubtitles"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnSubtitles"
                        android:nextFocusLeft="@+id/btnAudioBoost"
                        android:nextFocusRight="@+id/btnResizeMode"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_sub_btn"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnResizeMode"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnResizeMode"
                        android:nextFocusLeft="@+id/btnSubtitles"
                        android:nextFocusRight="@+id/btnEngineSwitch"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_resize_fit"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEngineSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnEngineSwitch"
                        android:nextFocusLeft="@+id/btnResizeMode"
                        android:nextFocusRight="@+id/btnAltSources"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_engine_switch_vlc_hw"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnAltSources"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnAltSources"
                        android:nextFocusLeft="@+id/btnEngineSwitch"
                        android:nextFocusRight="@+id/btnEpisodes"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_alt_sources_btn"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnEpisodes"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnEpisodes"
                        android:nextFocusLeft="@+id/btnResizeMode"
                        android:nextFocusRight="@+id/btnNextEpisode"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_episodes_btn"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnNextEpisode"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnNextEpisode"
                        android:nextFocusLeft="@+id/btnEpisodes"
                        android:nextFocusRight="@+id/btnAutoNext"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_next_short"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/btnAutoNext"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_player_pill_selector"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:nextFocusDown="@+id/btnAutoNext"
                        android:nextFocusLeft="@+id/btnNextEpisode"
                        android:nextFocusRight="@+id/btnAutoNext"
                        android:nextFocusUp="@+id/btnPlayPause"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp"
                        android:singleLine="true"
                        android:text="@string/player_auto_next_on"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>
        </LinearLayout>
    </FrameLayout>

    <!-- Next Episode Countdown Card -->
    <LinearLayout
        android:id="@+id/layoutNextEpisode"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="28dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextEpisodeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_emerald"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNextEpisodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnNextCancel"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnNextCancel"
                android:nextFocusRight="@+id/btnNextPlayNow"
                android:text="@string/btn_cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextPlayNow"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1.3"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnNextCancel"
                android:nextFocusRight="@+id/btnNextPlayNow"
                android:text="@string/player_next_now"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
