<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- Full-screen touch gesture surface for tablets & phones (ignored by TV D-pad) -->
    <View
        android:id="@+id/viewTouchSurface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="false"
        android:focusableInTouchMode="false" />

    <!-- Top compact HUD pill for seek / brightness / volume / resize notifications -->
    <TextView
        android:id="@+id/tvQuickHud"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_dialog"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- TV & Touch OSD Controls Overlay -->
    <LinearLayout
        android:id="@+id/layoutOsd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPlayerTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreamInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <!-- Tapping empty middle space hides OSD on touchscreens (ignored by TV D-pad) -->
        <View
            android:id="@+id/viewOsdDismissArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="false"
            android:focusableInTouchMode="false" />

        <!-- Interactive SeekBar + time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_weight="1"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:max="1000"
                android:progress="0"
                android:progressTint="@color/accent_emerald"
                android:thumbTint="@color/accent_emerald" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Primary action buttons row for remote D-pad and touch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnRewind"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnRewind"
                android:nextFocusRight="@+id/btnPlayPause"
                android:nextFocusUp="@+id/btnRewind"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_rewind_btn"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnPlayPause"
                android:layout_width="118dp"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnRewind"
                android:nextFocusRight="@+id/btnForward"
                android:nextFocusUp="@+id/btnPlayPause"
                android:text="Пауза"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnForward"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnPlayPause"
                android:nextFocusRight="@+id/btnAudioTrack"
                android:nextFocusUp="@+id/btnForward"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_forward_btn"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAudioTrack"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnForward"
                android:nextFocusRight="@+id/btnSubtitles"
                android:nextFocusUp="@+id/btnAudioTrack"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="@string/player_audio_btn"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSubtitles"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnAudioTrack"
                android:nextFocusRight="@+id/btnResizeMode"
                android:nextFocusUp="@+id/btnSubtitles"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="@string/player_sub_btn"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnResizeMode"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnSubtitles"
                android:nextFocusRight="@+id/btnResizeMode"
                android:nextFocusUp="@+id/btnResizeMode"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="@string/player_resize_fit"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Secondary row for multi-episode torrents (series) -->
        <LinearLayout
            android:id="@+id/layoutSeriesRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnEpisodes"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnEpisodes"
                android:nextFocusLeft="@+id/btnEpisodes"
                android:nextFocusRight="@+id/btnNextEpisode"
                android:nextFocusUp="@+id/btnPlayPause"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_episodes_btn"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextEpisode"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnNextEpisode"
                android:nextFocusLeft="@+id/btnEpisodes"
                android:nextFocusRight="@+id/btnAutoNext"
                android:nextFocusUp="@+id/btnForward"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_next_episode_btn"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnAutoNext"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnAutoNext"
                android:nextFocusLeft="@+id/btnNextEpisode"
                android:nextFocusRight="@+id/btnAutoNext"
                android:nextFocusUp="@+id/btnAudioTrack"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_auto_next_on"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Auto-next Episode Countdown Card (bottom-right) -->
    <LinearLayout
        android:id="@+id/layoutNextEpisode"
        android:layout_width="370dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="30dp"
        android:background="@drawable/bg_dialog"
        android:orientation="vertical"
        android:padding="18dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvNextEpisodeHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/accent_emerald"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNextEpisodeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnNextCancel"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnNextCancel"
                android:nextFocusLeft="@+id/btnNextCancel"
                android:nextFocusRight="@+id/btnNextPlayNow"
                android:nextFocusUp="@+id/btnNextCancel"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/player_next_cancel"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnNextPlayNow"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnNextPlayNow"
                android:nextFocusLeft="@+id/btnNextCancel"
                android:nextFocusRight="@+id/btnNextPlayNow"
                android:nextFocusUp="@+id/btnNextPlayNow"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/player_next_watch_now"
                android:textColor="@color/text_button_accent_selector"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
