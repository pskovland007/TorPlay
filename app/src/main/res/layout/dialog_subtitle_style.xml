<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sub_style_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="12dp"
        android:background="#1A2230"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvSubStylePreview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="@string/sub_style_preview"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sub_style_size_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSubSizeSmall"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubBgTransparent"
            android:nextFocusLeft="@+id/btnSubSizeSmall"
            android:nextFocusRight="@+id/btnSubSizeNormal"
            android:nextFocusUp="@+id/btnSubSizeSmall"
            android:text="@string/sub_size_small"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubSizeNormal"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubBgTranslucent"
            android:nextFocusLeft="@+id/btnSubSizeSmall"
            android:nextFocusRight="@+id/btnSubSizeLarge"
            android:nextFocusUp="@+id/btnSubSizeNormal"
            android:text="@string/sub_size_normal"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubSizeLarge"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubBgTranslucent"
            android:nextFocusLeft="@+id/btnSubSizeNormal"
            android:nextFocusRight="@+id/btnSubSizeHuge"
            android:nextFocusUp="@+id/btnSubSizeLarge"
            android:text="@string/sub_size_large"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubSizeHuge"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubBgBlack"
            android:nextFocusLeft="@+id/btnSubSizeLarge"
            android:nextFocusRight="@+id/btnSubSizeHuge"
            android:nextFocusUp="@+id/btnSubSizeHuge"
            android:text="@string/sub_size_huge"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sub_style_bg_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnSubBgTransparent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubStyleApply"
            android:nextFocusLeft="@+id/btnSubBgTransparent"
            android:nextFocusRight="@+id/btnSubBgTranslucent"
            android:nextFocusUp="@+id/btnSubSizeSmall"
            android:text="@string/sub_bg_transparent"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubBgTranslucent"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubStyleApply"
            android:nextFocusLeft="@+id/btnSubBgTransparent"
            android:nextFocusRight="@+id/btnSubBgBlack"
            android:nextFocusUp="@+id/btnSubSizeNormal"
            android:text="@string/sub_bg_translucent"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSubBgBlack"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/btnSubStyleApply"
            android:nextFocusLeft="@+id/btnSubBgTranslucent"
            android:nextFocusRight="@+id/btnSubBgBlack"
            android:nextFocusUp="@+id/btnSubSizeHuge"
            android:text="@string/sub_bg_black"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnSubStyleApply"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnSubStyleApply"
        android:nextFocusLeft="@+id/btnSubStyleApply"
        android:nextFocusRight="@+id/btnSubStyleApply"
        android:nextFocusUp="@+id/btnSubBgTranslucent"
        android:text="@string/sub_style_apply"
        android:textColor="@color/text_button_accent_selector"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
