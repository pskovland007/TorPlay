<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvShowcaseActionTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvShowcaseActionMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="16dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/btnShowcaseWatch"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnShowcaseFavorite"
        android:nextFocusLeft="@+id/btnShowcaseWatch"
        android:nextFocusRight="@+id/btnShowcaseWatch"
        android:nextFocusUp="@+id/btnShowcaseWatch"
        android:text="@string/showcase_action_watch"
        android:textColor="@color/text_button_accent_selector"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnShowcaseFavorite"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnShowcaseFindAll"
        android:nextFocusLeft="@+id/btnShowcaseFavorite"
        android:nextFocusRight="@+id/btnShowcaseFavorite"
        android:nextFocusUp="@+id/btnShowcaseWatch"
        android:text="@string/showcase_action_fav_add"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnShowcaseFindAll"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnShowcaseCancel"
        android:nextFocusLeft="@+id/btnShowcaseFindAll"
        android:nextFocusRight="@+id/btnShowcaseFindAll"
        android:nextFocusUp="@+id/btnShowcaseFavorite"
        android:text="@string/showcase_action_find_all"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btnShowcaseCancel"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@drawable/bg_button_selector"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:nextFocusDown="@+id/btnShowcaseCancel"
        android:nextFocusLeft="@+id/btnShowcaseCancel"
        android:nextFocusRight="@+id/btnShowcaseCancel"
        android:nextFocusUp="@+id/btnShowcaseFindAll"
        android:text="@string/btn_cancel"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
