<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:id="@+id/tvAltTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="@string/alt_sources_title"
        android:textColor="@color/text_primary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAltSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="10dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <!-- Quick Quality & Dub Filter Chips above Alternative Sources list -->
    <LinearLayout
        android:id="@+id/layoutAltFilters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/btnAltFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvAltTorrents"
            android:nextFocusLeft="@+id/btnAltFilterAll"
            android:nextFocusRight="@+id/btnAltFilter4k"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_all"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAltFilter4k"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvAltTorrents"
            android:nextFocusLeft="@+id/btnAltFilterAll"
            android:nextFocusRight="@+id/btnAltFilter1080"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_4k"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAltFilter1080"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvAltTorrents"
            android:nextFocusLeft="@+id/btnAltFilter4k"
            android:nextFocusRight="@+id/btnAltFilter720"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_1080"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAltFilter720"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvAltTorrents"
            android:nextFocusLeft="@+id/btnAltFilter1080"
            android:nextFocusRight="@+id/btnAltFilterDub"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_720"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAltFilterDub"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_chip_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvAltTorrents"
            android:nextFocusLeft="@+id/btnAltFilter720"
            android:nextFocusRight="@+id/btnAltFilterDub"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/filter_dub"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutAltLoading"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp">

        <ProgressBar
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:indeterminateTint="@color/accent_emerald" />

        <TextView
            android:id="@+id/tvAltLoadingText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/alt_sources_searching"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAltEmpty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:padding="18dp"
        android:text="@string/alt_sources_empty"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAltTorrents"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="8dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAltWait"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnAltWait"
            android:nextFocusRight="@+id/btnAltManualSearch"
            android:text="@string/alt_sources_btn_wait"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnAltManualSearch"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusLeft="@+id/btnAltWait"
            android:nextFocusRight="@+id/btnAltManualSearch"
            android:text="@string/alt_sources_btn_manual"
            android:textColor="@color/text_button_accent_selector"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
