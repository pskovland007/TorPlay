<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="22dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ts_manager_title"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTsManagerSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ts_manager_loading"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnTsRefresh"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvTsTorrents"
            android:nextFocusLeft="@+id/btnTsRefresh"
            android:nextFocusRight="@+id/btnTsClearAll"
            android:nextFocusUp="@+id/btnTsRefresh"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ts_manager_refresh"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTsClearAll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvTsTorrents"
            android:nextFocusLeft="@+id/btnTsRefresh"
            android:nextFocusRight="@+id/btnTsClose"
            android:nextFocusUp="@+id/btnTsClearAll"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ts_manager_clear_all"
            android:textColor="@color/status_err"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnTsClose"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button_selector"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusDown="@+id/rvTsTorrents"
            android:nextFocusLeft="@+id/btnTsClearAll"
            android:nextFocusRight="@+id/btnTsClose"
            android:nextFocusUp="@+id/btnTsClose"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/ts_manager_close"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTsTorrents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nextFocusUp="@+id/btnTsRefresh"
            android:paddingBottom="6dp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/layoutTsEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressTsLoading"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginBottom="10dp"
                android:indeterminateTint="@color/accent_emerald"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvTsEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ts_manager_loading"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
