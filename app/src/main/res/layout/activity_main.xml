<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- Header row: Logo + TorrServe status + Favorite + Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TorPlay"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="TV"
                android:textColor="@color/accent_emerald"
                android:textSize="14sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/btnTorrServeStatus"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_status_pill"
                android:clickable="true"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center_vertical"
                android:nextFocusDown="@+id/etSearch"
                android:nextFocusLeft="@+id/btnTorrServeStatus"
                android:nextFocusRight="@+id/btnFavoriteQuery"
                android:nextFocusUp="@+id/btnTorrServeStatus"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <View
                    android:id="@+id/viewStatusDot"
                    android:layout_width="9dp"
                    android:layout_height="9dp"
                    android:layout_marginEnd="7dp"
                    android:background="@color/status_warn" />

                <TextView
                    android:id="@+id/tvTorrServeStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_checking"
                    android:textColor="@color/text_primary"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnFavoriteQuery"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnVoiceSearch"
                android:nextFocusLeft="@+id/btnTorrServeStatus"
                android:nextFocusRight="@+id/btnSettings"
                android:nextFocusUp="@+id/btnFavoriteQuery"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_fav_toggle"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/btnSearch"
                android:nextFocusLeft="@+id/btnFavoriteQuery"
                android:nextFocusRight="@+id/btnSettings"
                android:nextFocusUp="@+id/btnSettings"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/btn_settings"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/etSearch"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input_selector"
                android:hint="@string/search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:nextFocusLeft="@+id/etSearch"
                android:nextFocusRight="@+id/btnVoiceSearch"
                android:nextFocusUp="@+id/btnTorrServeStatus"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/btnVoiceSearch"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:contentDescription="@string/btn_voice"
                android:descendantFocusability="blocksDescendants"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/etSearch"
                android:nextFocusRight="@+id/btnSearch"
                android:nextFocusUp="@+id/btnFavoriteQuery"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_mic" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_voice"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnSearch"
                android:layout_width="124dp"
                android:layout_height="46dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusLeft="@+id/btnVoiceSearch"
                android:nextFocusRight="@+id/btnSearch"
                android:nextFocusUp="@+id/btnSettings"
                android:text="@string/btn_search"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Recent Search Queries Row (visible on Home screen when history exists) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvRecentSearches"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:nextFocusUp="@+id/etSearch"
            android:paddingBottom="8dp"
            android:visibility="gone" />

        <!-- Filter & Sort Bar (visible when search results exist) -->
        <LinearLayout
            android:id="@+id/layoutFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilterAll"
                android:nextFocusRight="@+id/btnFilter4k"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_all"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilter4k"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilterAll"
                android:nextFocusRight="@+id/btnFilter1080"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_4k"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilter1080"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilter4k"
                android:nextFocusRight="@+id/btnFilter720"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_1080"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilter720"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilter1080"
                android:nextFocusRight="@+id/btnFilterHdr"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_720"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilterHdr"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilter720"
                android:nextFocusRight="@+id/btnFilterNoCam"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_hdr"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilterNoCam"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilterHdr"
                android:nextFocusRight="@+id/btnFilterLiveSeeds"
                android:nextFocusUp="@+id/etSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_no_cam"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnFilterLiveSeeds"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilterNoCam"
                android:nextFocusRight="@+id/btnSort"
                android:nextFocusUp="@+id/btnVoiceSearch"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/filter_live_seeds"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSearchMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnSort"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_selector"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:nextFocusDown="@+id/rvResults"
                android:nextFocusLeft="@+id/btnFilterLiveSeeds"
                android:nextFocusRight="@+id/btnSort"
                android:nextFocusUp="@+id/btnSearch"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/sort_seeds"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Home Shelves: History & Favorites (visible when not showing search results) -->
        <LinearLayout
            android:id="@+id/layoutHomeShelves"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Favorites Shelf -->
            <TextView
                android:id="@+id/tvFavoritesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="6dp"
                android:text="@string/favorites_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvFavorites"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:nextFocusUp="@+id/etSearch"
                android:visibility="gone" />

            <!-- History Shelf -->
            <TextView
                android:id="@+id/tvHistoryHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:text="@string/history_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvHistory"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Prompt / Searching / Empty / No-filtered-results state -->
        <LinearLayout
            android:id="@+id/layoutEmpty"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ProgressBar
                android:id="@+id/progressSearch"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="12dp"
                android:indeterminateTint="@color/accent_emerald"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvEmptyMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingMultiplier="1.3"
                android:text="@string/empty_prompt"
                android:textColor="@color/text_secondary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Search Results List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvResults"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:nextFocusUp="@+id/btnFilterAll"
            android:paddingBottom="12dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Buffering & Launch Overlay -->
    <FrameLayout
        android:id="@+id/layoutLoadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="480dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_dialog"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <ProgressBar
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginBottom="14dp"
                android:indeterminateTint="@color/accent_emerald" />

            <TextView
                android:id="@+id/tvLoadingTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="2"
                android:text="Подготовка потока…"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLoadingStep"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Подключение к TorrServe…"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/progressBuffer"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="16dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/accent_emerald"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvLoadingStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/accent_emerald"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Нажмите «Назад» на пульте для отмены"
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
