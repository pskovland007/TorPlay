<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#A610B981" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#9910B981" />
            <stroke android:width="2dp" android:color="#E2E8F0" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#6E12171F" />
            <stroke android:width="1.5dp" android:color="#99FFFFFF" />
        </shape>
    </item>
</selector>
