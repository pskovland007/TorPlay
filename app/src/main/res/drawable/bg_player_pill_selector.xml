<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#D910B981" />
            <corners android:radius="20dp" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#B310B981" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#730D2E25" />
            <corners android:radius="20dp" />
            <stroke android:width="1.5dp" android:color="#10B981" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#99141A22" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</selector>
